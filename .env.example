# ============================================================================
# REQUIRED
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Choose ONE:
#
# Option 1: SQLite (Easiest - no external DB needed)
# Leave DATABASE_URL empty or unset. Uses file-based SQLite databases:
#   - Repository: data/pipelines.db
#   - Memory: data/agent_memory.db
#
# Option 2: PostgreSQL (Production)
# Set DATABASE_URL to connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_agent_org
#
# Default in code is PostgreSQL, so for SQLite you MUST either:
#   - Set DATABASE_URL="" in this file, OR
#   - Edit config/settings.py to change default
DATABASE_URL=

# ============================================================================
# APP CONFIG
# ============================================================================
MODEL=claude-opus-4-5
FAST_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=4096
MEMORY_DB_PATH=data/agent_memory.db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# Safety
MAX_PIPELINE_COST_USD=5.00

# Feature flags
ENABLE_COST_TRACKING=true
ENABLE_SLACK_NOTIFICATIONS=false
ENABLE_JIRA_INTEGRATION=false
ENABLE_GITHUB_INTEGRATION=false

# ============================================================================
# OPTIONAL INTEGRATIONS (uncomment and fill if using)
# ============================================================================

# GitHub
# GITHUB_TOKEN=ghp_your_token
# GITHUB_DEFAULT_REPO=yourorg/yourrepo

# Jira
# JIRA_TOKEN=your_jira_api_token
# JIRA_EMAIL=you@yourcompany.com
# JIRA_BASE_URL=https://yourorg.atlassian.net
# JIRA_PROJECT_KEY=APP

# Figma
# FIGMA_TOKEN=figd_your_figma_token
# FIGMA_FILE_KEY=your_figma_file_key

# Slack
# SLACK_BOT_TOKEN=xoxb-your-slack-token
# SLACK_CHANNEL=#dev-agents

# ============================================================================
# INFRASTRUCTURE (Architecture Overhaul)
# ============================================================================
REDIS_URL=redis://localhost:6379
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-1234  # Use a strong key in production

# MULTI-LLM PROVIDERS
OPENAI_API_KEY=
GEMINI_API_KEY=
